{
    "name": "libecrs",
    "description": "A -betterC D entity-component-relation-system library",
    "targetType": "sourceLibrary",
    "sourcePaths": ["source"],
    "importPaths": ["source"],
    "dflags-ldc": ["-betterC", "-checkaction=C"],
    "dflags-dmd": ["-betterC", "-checkaction=C"],
    "dependencies": {
        "libfp": {
            "repository": "git+https://github.com/doir-lang/libfp.git",
            "version": "674acd77c2b8411144c2e162015145df7edcf1a0"
        },
        "bc-threads": {
            "repository": "git+https://github.com/doir-lang/bc-threads.git",
            "version": "f3e45474cb010bcdca84c30b60619b4c61249dc1"
        }
    },
    "subConfigurations": {
        "libfp": "library",
        "bc-threads": "library"
    },
    "configurations": [
        {
            "name": "library",
            "targetType": "sourceLibrary"
        },
        {
            "name": "unittest",
            "targetType": "executable",
            "mainSourceFile": "tests/runner.d",
            "sourcePaths": ["source", "tests"],
            "importPaths": ["source", "tests"],
            "dflags-ldc": ["-betterC", "-checkaction=C"],
            "dflags-dmd": ["-betterC", "-checkaction=C"]
        },
        {
            "name": "simple",
            "targetType": "executable",
            "mainSourceFile": "examples/simple.d",
            "sourcePaths": ["source", "examples"],
            "importPaths": ["source", "examples"],
            "dflags-ldc": ["-betterC", "-checkaction=C"],
            "dflags-dmd": ["-betterC", "-checkaction=C"]
        }
    ]
}
